# ====================================================================
# VARIABLES DE ENTORNO - ECLIPSE STORE
# ====================================================================

# Modo de Persistencia:
# Si las variables de Supabase están vacías, el sistema opera automáticamente
# en modo persistente relacional local (SQLite en disco: data/eclipse_store.db)
# garantizando transacciones reales, kardex, caja y punto de venta sin depender de la nube.
# Cuando configures tu proyecto en Supabase, copia tus credenciales aquí.

# Supabase URL (de la consola de tu proyecto Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Key (clave pública segura para el frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (opcional, solo para tareas administrativas en el servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Configuración de Marca y WhatsApp
NEXT_PUBLIC_STORE_NAME=Eclipse Store
NEXT_PUBLIC_STORE_PHONE=+51 900 000 000
NEXT_PUBLIC_WHATSAPP_NUMBER=51900000000
NEXT_PUBLIC_CURRENCY=PEN
NEXT_PUBLIC_CURRENCY_SYMBOL=S/
